<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof appName !== 'undefined' ? appName : 'SahabatUMKM' %> | 404 Tidak Ditemukan</title>
  <meta name="description" content="Halaman tidak ditemukan">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="main-content">
    <div class="container text-center" style="padding: 5rem 0;">
      <div style="font-size: 4rem; margin-bottom: 1rem;">🔍</div>
      <h1 style="font-size: 3rem; font-weight: 800; margin-bottom: 0.5rem; color: var(--clr-text);">404</h1>
      <h2 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 1rem; color: var(--clr-text-muted);">Halaman Tidak Ditemukan</h2>
      <p style="color: var(--clr-text-muted); max-width: 400px; margin: 0 auto 2rem auto; font-size: 0.95rem;">
        Maaf, halaman yang Anda akses tidak ditemukan atau sudah dipindahkan.
      </p>
      <a href="/" class="btn-primary" style="display: inline-block; text-decoration: none;">← Kembali ke Beranda</a>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>