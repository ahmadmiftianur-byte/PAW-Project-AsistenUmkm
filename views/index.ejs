<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= appName %> | Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark topbar"><div class="container">
  <a class="navbar-brand fw-bold" href="/">SahabatUMKM</a>
  <span class="navbar-text text-white-50 small">Project PPAW · Week 7</span>
</div></nav>
<main class="container py-4 py-lg-5">
  <section class="hero p-4 p-lg-5 mb-4">
    <span class="eyebrow">DASHBOARD USAHA</span>
    <div class="row align-items-center g-4 mt-1">
      <div class="col-lg-8"><h1 class="display-5 fw-bold">Kelola informasi usaha dengan lebih teratur.</h1>
        <p class="lead mt-3 mb-0">SahabatUMKM adalah fondasi aplikasi pendamping pelaku usaha. Pada tahap ini, halaman menampilkan data produk yang dikirim oleh backend Express.</p></div>
      <div class="col-lg-4"><div class="status-card"><div class="small text-secondary">STATUS APLIKASI</div><div class="d-flex align-items-center gap-2 mt-2"><span class="status-dot"></span><strong>Server aktif</strong></div><a href="/api/status" class="small mt-3 d-inline-block">Lihat response API status →</a></div></div>
    </div>
  </section>
  <section class="row g-3 mb-5">
    <div class="col-md-4"><div class="stat-card"><div class="stat-label">TOTAL CONTOH PRODUK</div><div class="stat-number"><%= produk.length %></div><div class="text-secondary small">Data berasal dari Model</div></div></div>
    <div class="col-md-4"><div class="stat-card"><div class="stat-label">BACKEND</div><div class="stat-number">Express.js</div><div class="text-secondary small">Mengelola request dan response</div></div></div>
    <div class="col-md-4"><div class="stat-card"><div class="stat-label">VIEW ENGINE</div><div class="stat-number">EJS</div><div class="text-secondary small">Merender halaman dari backend</div></div></div>
  </section>
  <section class="mb-5"><div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3"><div><span class="eyebrow">KATALOG CONTOH</span><h2 class="h3 fw-bold mb-0 mt-1">Produk UMKM</h2></div><a href="/api/produk" class="btn btn-outline-success btn-sm">Buka API produk</a></div>
    <div class="row g-3"><% produk.forEach((item, index) => { %><div class="col-md-4"><article class="product-card h-100"><div class="d-flex justify-content-between"><span class="product-index">PRODUK 0<%= index + 1 %></span><span class="badge rounded-pill category"><%= item.kategori %></span></div><h3 class="h5 fw-bold mt-4"><%= item.nama %></h3><p class="text-secondary small"><%= item.deskripsi %></p><div class="price mt-3"><%= formatRupiah(item.harga) %></div></article></div><% }) %></div>
  </section>
  <section class="next-card p-4"><span class="eyebrow">PENGEMBANGAN SELANJUTNYA</span><h2 class="h4 fw-bold mt-2">Asisten UMKM akan dikembangkan bertahap</h2><p class="text-secondary mb-0">Fitur chatbot untuk membantu ide promosi dan deskripsi produk merupakan arah pengembangan project pada minggu berikutnya. Fitur tersebut bukan bagian wajib dari implementasi Week 7 ini.</p></section>
  <footer class="text-center text-secondary small py-4">SahabatUMKM · Express.js · EJS · Bootstrap</footer>
</main>
</body></html>
